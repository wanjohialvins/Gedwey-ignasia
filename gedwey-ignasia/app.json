{
  "expo": {
    "name": "gedwey-ignasia",
    "slug": "gedwey-ignesia",
    "scheme": "gedwey-ignasia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wanjohialvins.gedweyignasia"
    },
    "android": {
      "package": "com.wanjohialvins.gedweyignasia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b54ba96-bd86-4647-8554-e12af592359d"
      }
    },
    "owner": "alvinschlof"
  }
}
