{
  "expo": {
    "name": "Gedwey Ignasia",
    "slug": "gedwey-ignesia",
    "scheme": "gedwey-ignasia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFF6FF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wanjohialvins.gedweyignasia"
    },
    "android": {
      "package": "com.wanjohialvins.gedweyignasia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFF6FF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/0b54ba96-bd86-4647-8554-e12af592359d"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F46E5"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Gedwey Ignasia to record voice notes for sessions and journal entries."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b54ba96-bd86-4647-8554-e12af592359d"
      }
    },
    "owner": "alvinschlof"
  }
}
