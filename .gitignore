# Ignore agents folder and its rules
.agents/
.agents/*

# Ignore all markdown files in root and subdirectories if needed
*.md
**/*.md

# Ignore local environment variables and build artifacts
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependency and output directories
node_modules/
.expo/
dist/
web-build/

# Debug files
npm-debug.*
yarn-debug.*
yarn-error.*

# Native/certificates
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro cache
.metro-health-check*

# macOS
.DS_Store
